<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ch.stefflix.app"
    android:versionCode="10102"
    android:versionName="1.1.2" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates der App direkt installieren (App-Einstellungen › Über die App) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- largeHeap: Videopuffer bis 128 MB im Arbeitsspeicher -->
    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_launcher"
        android:label="STEFFLIX"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Sflix" >
        <activity
            android:name="ch.stefflix.app.ShareListActivity"
            android:exported="true"
            android:launchMode="singleTop" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="ch.stefflix.app.BrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
            android:exported="false" />
        <activity
            android:name="ch.stefflix.app.SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
            android:exported="false" />

        <receiver
            android:name="ch.stefflix.app.AppUpdate$InstallReceiver"
            android:exported="false" />
    </application>

</manifest>